 {
@@ -107,3 +124,37 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+uint64
+sys_processinfo(void)
+{
+  int pid;
+  uint64 uaddr;          // user-space address for struct procinfo
+  struct procinfo info;
+  struct proc *p;
+
+  if(argint(0, &pid) < 0)
+    return -1;
+  if(argaddr(1, &uaddr) < 0)
+    return -1;
+
+  // search the process table
+  for(p = proc; p < &proc[NPROC]; p++){
+    if(p->pid == pid){
+      info.pid = p->pid;
+      info.ppid = p->parent ? p->parent->pid : 0;
+      info.state = p->state;
+      info.sz = p->sz;
+      info.ctime = 0;   // placeholder for now
+      safestrcpy(info.name, p->name, sizeof(info.name));
+
+      if(copyout(myproc()->pagetable, uaddr,
+                 (char*)&info, sizeof(info)) < 0)
+        return -1;
+
+      return 0;
+    }
+  }
+
+  // pid not found
+  return -1;
+}
